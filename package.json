{
  "name": "recursos-upfunnel-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio estático de clases y recursos de Upfunnel.",
  "scripts": {
    "dev": "http-server . -a 127.0.0.1 -p 4173 -c-1",
    "format": "prettier --write \"*.{html,json,md}\" \"docs/**/*.md\" \"assets/**/*.{css,js}\" \"scripts/**/*.mjs\" \"tests/**/*.js\" \".github/**/*.{yml,yaml,json}\"",
    "format:check": "prettier --check \"*.{html,json,md}\" \"docs/**/*.md\" \"assets/**/*.{css,js}\" \"scripts/**/*.mjs\" \"tests/**/*.js\" \".github/**/*.{yml,yaml,json}\"",
    "lint:js": "eslint assets/js sw.js scripts tests playwright.config.js",
    "lint:css": "stylelint \"assets/**/*.css\"",
    "lint:html": "html-validate index.html privacidad.html",
    "validate": "node scripts/validate-project.mjs",
    "check": "npm run format:check && npm run lint:js && npm run lint:css && npm run lint:html && npm run validate",
    "test": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "html-validate": "^9.7.1",
    "http-server": "^14.1.1",
    "prettier": "^3.6.2",
    "stylelint": "^16.23.0",
    "stylelint-config-standard": "^38.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
